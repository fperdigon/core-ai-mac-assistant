<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MacPocketKnife</string>
    <key>CFBundleDisplayName</key>
    <string>MacPocketKnife</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.fperdigon.macpocketknife</string>
    <key>CFBundleExecutable</key>
    <string>MacPocketKnife</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>CAMGitSHA</key>
    <string>@GIT_SHA@</string>
    <key>CAMBuildChannel</key>
    <string>@BUILD_CHANNEL@</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>MacPocketKnife uses your microphone only while you dictate, to transcribe speech on this Mac.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>MacPocketKnife uses on-device speech recognition to turn dictation into text for your clipboard.</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright 2026 Francisco Perdigon Romero and contributors</string>
</dict>
</plist>
